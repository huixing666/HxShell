<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 项目/目录已更名 HxShell，但产物名保持不变（用户侧旧快捷方式/启动脚本不受影响）；
         csproj 改名后程序集名默认跟随文件名，必须显式固定 -->
    <AssemblyName>HxServerFileManager.Desktop</AssemblyName>
    <RootNamespace>HxServerFileManager.Desktop</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 应用版本：显示在窗口标题（与主项目保持一致，改版本号时两边一起改） -->
    <Version>1.2.0</Version>
    <!-- 桌面壳不弹控制台窗口（Windows） -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- 应用图标：仓库根目录 logo.ico（嵌入 exe；并复制一份到输出目录供窗口 SetIconFile 运行时加载） -->
    <ApplicationIcon>..\logo.ico</ApplicationIcon>
    <!-- 不产出独立 .pdb 文件：调试符号内嵌进程序集（产物目录干净，同时保留调试能力） -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Photino.NET：跨平台轻量 WebView（Windows=WebView2 / macOS=WKWebView / Linux=WebKitGTK）。
         不要用 3.0.14 —— 该版本在 Windows 上建出的窗口失效（实测只剩标题栏大小），4.0.16 正常。 -->
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- 引用主项目，复用 Web 服务构建逻辑。SetRuntimeIdentifier 让主项目与桌面壳用相同 RID 输出 -->
    <ProjectReference Include="..\HxShell\HxShell.csproj" SetRuntimeIdentifier="true" />
  </ItemGroup>

  <!-- 窗口图标：logo.png 作为内嵌资源打包（构建产物不落散文件），
       启动时解出到临时目录供 Photino SetIconFile 加载（PNG 三平台通用）。
       注意：不要改用 logo.ico —— gdk-pixbuf 的 ICO 加载器对现代多尺寸 ico 支持很差。 -->
  <ItemGroup>
    <EmbeddedResource Include="..\logo.png" LogicalName="logo.png" />
  </ItemGroup>

  <!--
    wwwroot 是通过自定义 target 镜像的（非 Content 项），dotnet publish 不会自动带入。
    Build/Publish 都执行：$(OutDir)、$(PublishDir) 双份镜像（先清后拷，同主项目逻辑）。
    缺了发布目录里的 wwwroot，桌面壳启动后会因静态资源 404 而白屏。
  -->
  <Target Name="CopyWwwrootToDesktopOutput" AfterTargets="Build;Publish">
    <ItemGroup>
      <WwwrootSource Include="$(MSBuildThisFileDirectory)..\HxShell\wwwroot\**\*" />
      <WwwrootStale Include="$(OutDir)wwwroot\**\*;$(PublishDir)wwwroot\**\*" />
    </ItemGroup>
    <Delete Files="@(WwwrootStale)" ContinueOnError="true" />
    <Copy SourceFiles="@(WwwrootSource)" DestinationFiles="@(WwwrootSource->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(WwwrootSource)" DestinationFiles="@(WwwrootSource->'$(PublishDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Importance="high" Text="wwwroot -&gt; $(OutDir)wwwroot 与 $(PublishDir)wwwroot：已复制 @(WwwrootSource-&gt;Count()) 个文件" />
  </Target>

  <!--
    同主项目：让 VS 的快速最新检查（fast up-to-date check）盯住主项目的 wwwroot，
    否则只改前端时 F5 会判定"项目已是最新"直接跳过 Build，上面的镜像 target 不执行，
    桌面壳里看到的还是输出目录里的旧前端。
  -->
  <ItemGroup>
    <UpToDateCheckInput Include="$(MSBuildThisFileDirectory)..\HxShell\wwwroot\**\*" Visible="false" />
  </ItemGroup>

  <!--
    主项目是 Exe（top-level statement 要求），ProjectReference 会把它的启动器/宿主也复制过来。
    桌面壳只需要 DLL：Windows 下多出 HxServerFileManager.exe，macOS/Linux 下多出无扩展名的
    HxServerFileManager 二进制，连同 .pdb 与 .runtimeconfig.json 一并从输出和发布目录删掉，
    避免用户面对两个可执行文件分不清该点哪个。
    Build 后删除 $(OutDir) 里的，Publish 还会把主项目产物拷进 $(PublishDir)，需再删一次。
  -->
  <!--
    构建/发布输出清理：Data 目录是运行时在 ContentRoot 下按需生成的（连接/密钥/设置），
    不应随构建产物分发 —— 构建和发布后把输出目录里的 Data 内容清掉（含历史遗留文件）。
    首次运行时应用会自行重建空的 Data。
    Debug 构建跳过：调试时直接跑 bin/Debug 里的 exe，Data 作为本地调试数据保留（否则每次
    调试都要重新添加连接）；Release 构建与所有 publish 仍清理（发布产物绝不带 Data）。
    注意不能靠 $(PublishDir) 判空区分 build/publish —— 普通 build 时它也有默认值
    （bin\...\publish\），所以拆成两个 target：Build 钩子带条件，Publish 钩子无条件。
  -->
  <Target Name="CleanOutputData" AfterTargets="Build" Condition="'$(Configuration)' != 'Debug'">
    <ItemGroup>
      <!-- 同时清掉历史版本曾复制进输出的 logo.ico 散文件（当前 logo 已改为内嵌资源，不再拷贝） -->
      <OutputData Include="$(OutDir)Data\**\*;$(OutDir)logo.ico" />
    </ItemGroup>
    <Delete Files="@(OutputData)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutDir)Data" ContinueOnError="true" />
  </Target>
  <Target Name="CleanOutputDataPublish" AfterTargets="Publish">
    <ItemGroup>
      <OutputData Include="$(OutDir)Data\**\*;$(PublishDir)Data\**\*;$(OutDir)logo.ico;$(PublishDir)logo.ico" />
    </ItemGroup>
    <Delete Files="@(OutputData)" ContinueOnError="true" />
    <RemoveDir Directories="$(OutDir)Data;$(PublishDir)Data" ContinueOnError="true" />
  </Target>

  <Target Name="RemoveRedundantExe" AfterTargets="Build;Publish">
    <ItemGroup>
      <RedundantHost Include="$(OutDir)HxServerFileManager.exe;$(OutDir)HxServerFileManager;$(PublishDir)HxServerFileManager.exe;$(PublishDir)HxServerFileManager" />
      <RedundantSide Include="$(OutDir)HxServerFileManager.pdb;$(PublishDir)HxServerFileManager.pdb;$(OutDir)HxServerFileManager.runtimeconfig.json;$(PublishDir)HxServerFileManager.runtimeconfig.json" />
    </ItemGroup>
    <Delete Files="@(RedundantHost);@(RedundantSide)" ContinueOnError="true" />
  </Target>

</Project>
